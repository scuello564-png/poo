
using System;

class HabitacionHotel
{
    private int numero;
    private string tipo;
    private double precioPorNoche;
    private bool disponible;
    private string clienteActual;

    public int Numero
    {
        get { return numero; }
    }

    public string Tipo
    {
        get { return tipo; }
        set
        {
            if (value == "Individual" ||
                value == "Doble" ||
                value == "Suite")
            {
                tipo = value;
            }
            else
            {
                throw new ArgumentException(
                    "Tipo de habitacion no valido.");
            }
        }
    }

    public double PrecioPorNoche
    {
        get { return precioPorNoche; }
        set
        {
            if (value > 0)
            {
                precioPorNoche = value;
            }
            else
            {
                throw new ArgumentException(
                    "El precio debe ser mayor que cero.");
            }
        }
    }

    public bool Disponible
    {
        get { return disponible; }
    }

    public string ClienteActual
    {
        get { return clienteActual; }
    }

    public HabitacionHotel(int numero, string tipo,
                          double precioPorNoche)
    {
        this.numero = numero;
        Tipo = tipo;
        PrecioPorNoche = precioPorNoche;
        disponible = true;
        clienteActual = "";
    }

    public double Reservar(string nombreCliente, int noches)
    {
        if (!disponible)
        {
            return -1;
        }

        if (string.IsNullOrWhiteSpace(nombreCliente) ||
            noches <= 0)
        {
            throw new ArgumentException(
                "El nombre y la cantidad de noches deben ser validos.");
        }

        disponible = false;
        clienteActual = nombreCliente;

        return precioPorNoche * noches;
    }

    public bool Liberar()
    {
        if (disponible)
        {
            return false;
        }

        disponible = true;
        clienteActual = "";

        return true;
    }

    public string MostrarInfo()
    {
        string estado = disponible ? "Disponible" : "Ocupada";
        string cliente = disponible ? "Ninguno" : clienteActual;

        return "Numero: " + numero +
               "\nTipo: " + tipo +
               "\nPrecio por noche: $" + precioPorNoche.ToString("N0") +
               "\nEstado: " + estado +
               "\nCliente actual: " + cliente;
    }

    public void AplicarDescuento(int porcentaje)
    {
        if (porcentaje < 0 || porcentaje > 100)
        {
            throw new ArgumentOutOfRangeException(
                nameof(porcentaje),
                "El descuento debe estar entre 0 y 100.");
        }

        precioPorNoche = precioPorNoche *
                         (1 - porcentaje / 100.0);

        if (precioPorNoche < 0)
        {
            precioPorNoche = 0;
        }
    }
}

class Program
{
    static void Main(string[] args)
    {
        HabitacionHotel habitacion101 =
            new HabitacionHotel(101, "Individual", 50000);

        HabitacionHotel habitacion202 =
            new HabitacionHotel(202, "Doble", 80000);

        HabitacionHotel habitacion303 =
            new HabitacionHotel(303, "Suite", 150000);

        HabitacionHotel[] habitaciones =
        {
            habitacion101,
            habitacion202,
            habitacion303
        };

        Console.WriteLine("===== ESTADO INICIAL =====");

        foreach (HabitacionHotel habitacion in habitaciones)
        {
            Console.WriteLine(habitacion.MostrarInfo());
            Console.WriteLine("-------------------------");
        }

        Console.WriteLine("\n===== RESERVAS =====");

        double costo = habitacion101.Reservar(
            "Santiago Carranza", 3);

        Console.WriteLine(
            "Reserva de Santiago Carranza: $" +
            costo.ToString("N0"));

        costo = habitacion202.Reservar(
            "Jesus Maldonado", 2);

        Console.WriteLine(
            "Reserva de Jesus Maldonado: $" +
            costo.ToString("N0"));

        costo = habitacion101.Reservar(
            "Otro Cliente", 1);

        if (costo == -1)
        {
            Console.WriteLine(
                "Error: la habitacion 101 ya esta ocupada.");
        }

        bool resultado = habitacion101.Liberar();

        if (resultado)
        {
            Console.WriteLine(
                "La habitacion 101 fue liberada.");
        }
        else
        {
            Console.WriteLine(
                "La habitacion 101 ya estaba disponible.");
        }

        habitacion303.AplicarDescuento(10);

        Console.WriteLine(
            "Nuevo precio de la suite: $" +
            habitacion303.PrecioPorNoche.ToString("N0"));

        costo = habitacion101.Reservar("Carlos Ruiz", 1);

        Console.WriteLine(
            "Reserva de Carlos Ruiz: $" +
            costo.ToString("N0"));

        Console.WriteLine("\n===== ESTADO FINAL =====");

        foreach (HabitacionHotel habitacion in habitaciones)
        {
            Console.WriteLine(habitacion.MostrarInfo());
            Console.WriteLine("-------------------------");
        }

        int ocupadas = 0;

        foreach (HabitacionHotel habitacion in habitaciones)
        {
            if (!habitacion.Disponible)
            {
                ocupadas++;
            }
        }

        Console.WriteLine(
            "\nTotal de habitaciones ocupadas: " + ocupadas);
    }
}
